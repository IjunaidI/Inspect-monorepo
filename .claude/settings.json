{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./**/dist/**)",
      "Read(./**/.next/**)",
      "Read(./**/.turbo/**)",
      "Read(./**/.expo/**)",
      "Read(./**/ios/build/**)",
      "Read(./**/android/build/**)",
      "Read(./pnpm-lock.yaml)"
    ],
    "allow": [
      "Bash(pnpm type-check)",
      "Bash(pnpm build)",
      "Bash(pnpm api test)",
      "Bash(pnpm api test:*)",
      "Bash(pnpm web build)",
      "Bash(pnpm web type-check)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
