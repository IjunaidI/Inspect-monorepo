# ============================================================
# Inspect — environment template. Copy to `.env` at the repo root: `cp .env.example .env`.
# `.env` is gitignored; this template is tracked. NEVER put a real secret in this file.
# Placeholders below read CHANGE_ME / <description> — replace them in your own `.env`.
# ============================================================

# ------------------------------------------------------------
# LOCAL DEV (recommended) — docker-compose.dev.yml (Postgres 16 + Redis 7 + MinIO)
#   docker compose -f docker-compose.dev.yml up -d
# Then use these values (they match the compose defaults):
#   DATABASE_URL="postgresql://inspect:inspect@localhost:5432/inspect?schema=public"
#   REDIS_URL="redis://localhost:6379"
#   S3_ENDPOINT="http://localhost:9000"  S3_ACCESS_KEY_ID=inspect  S3_SECRET_ACCESS_KEY=inspect-secret
# ------------------------------------------------------------

NODE_ENV="development"

# ============================================================
# Database (Postgres) — the NestJS API reads DATABASE_URL.
# On Railway, ${{...}} are template references resolved automatically; for local
# dev, set DATABASE_URL to the compose value above (or your own Postgres).
# ============================================================
DATABASE_URL="postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}"
DATABASE_PUBLIC_URL="postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_TCP_PROXY_DOMAIN}}:${{RAILWAY_TCP_PROXY_PORT}}/${{PGDATABASE}}"

PGHOST="${{RAILWAY_PRIVATE_DOMAIN}}"
PGPORT="5432"
PGUSER="${{POSTGRES_USER}}"
PGPASSWORD="${{POSTGRES_PASSWORD}}"
PGDATABASE="${{POSTGRES_DB}}"
PGDATA="/var/lib/postgresql/data/pgdata"
POSTGRES_DB="inspect"
POSTGRES_USER="inspect"
POSTGRES_PASSWORD="CHANGE_ME"      # set in your .env / Railway secret manager — never commit a real value
SSL_CERT_DAYS="820"

# ============================================================
# Redis — the NestJS API reads REDIS_URL (required to boot; the cache module throws if unset).
# ============================================================
REDIS_URL="redis://${{REDISUSER}}:${{REDIS_PASSWORD}}@${{REDISHOST}}:${{REDISPORT}}"
REDIS_PUBLIC_URL="redis://default:${{REDIS_PASSWORD}}@${{RAILWAY_TCP_PROXY_DOMAIN}}:${{RAILWAY_TCP_PROXY_PORT}}"
REDIS_PASSWORD="CHANGE_ME"         # set in your .env / Railway secret manager — never commit a real value

# ============================================================
# NextAuth (web console). NEXTAUTH_URL must match the web port (3001 in local dev).
# Generate AUTH_SECRET: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
# ============================================================
NEXTAUTH_URL="http://localhost:3001"
AUTH_SECRET="CHANGE_ME"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ============================================================
# Web console -> API. Base URL the Next.js console calls server-side (falls back to
# design demo data when unreachable). NextAuth signs in via this API's POST /auth/login.
# ============================================================
INSPECT_API_URL="http://localhost:3000"
# API_PORT=3000
# WEB_PORT=3001

# ============================================================
# API auth — JWT issued by the NestJS API (the API is the RBAC authority).
# Generate each: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
# ============================================================
JWT_ACCESS_SECRET="CHANGE_ME"
JWT_REFRESH_SECRET="CHANGE_ME"
JWT_ACCESS_TTL_SECONDS="900"
JWT_REFRESH_TTL_SECONDS="2592000"

# ============================================================
# Object storage (S3 / MinIO) — presigned photo uploads (spec §13).
# Local dev: point at MinIO; access key/secret = MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
# ============================================================
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="inspect-photos"
S3_ACCESS_KEY_ID="CHANGE_ME"
S3_SECRET_ACCESS_KEY="CHANGE_ME"
S3_FORCE_PATH_STYLE="true"
MINIO_ROOT_USER="inspect"
MINIO_ROOT_PASSWORD="CHANGE_ME"

# ============================================================
# Report signing (Ed25519, spec §9). Generate a PKCS8 PEM keypair and paste the
# PRIVATE key here (double-quoted; dotenv preserves the multiline value):
#   node -e "console.log(require('crypto').generateKeyPairSync('ed25519',{privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}}).privateKey.trim())"
# Keep the real key OUT of source control.
# ============================================================
REPORT_SIGNING_PRIVATE_KEY_PEM=""

# ============================================================
# First-Platform-Admin bootstrap (optional). When BOTH email + password are set,
# `prisma db seed` upserts an ACTIVE PLATFORM_ADMIN (orgId=null) — the only way to
# create the first admin (org/user creation is admin-gated). Idempotent; leave
# unset in prod once a real admin exists.
# ============================================================
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="Platform Admin"
