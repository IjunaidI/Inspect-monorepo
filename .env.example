# ============================================================
# Inspect — environment template. Copy to `.env` at the repo root: `cp .env.example .env`.
# `.env` is gitignored; this template is tracked. NEVER put a real secret in this file.
# Placeholders below read CHANGE_ME / <description> — replace them in your own `.env`.
# ============================================================

# ------------------------------------------------------------
# LOCAL DEV (recommended) — docker-compose.dev.yml (Postgres 16 + Redis 7 + MinIO)
#   docker compose -f docker-compose.dev.yml up -d
# Then use these values (they match the compose defaults):
#   DATABASE_URL="postgresql://inspect:inspect@localhost:5432/inspect?schema=public"
#   REDIS_URL="redis://localhost:6379"
#   S3_ENDPOINT="http://localhost:9000"  S3_ACCESS_KEY_ID=inspect  S3_SECRET_ACCESS_KEY=inspect-secret
# ------------------------------------------------------------

NODE_ENV="development"

# ============================================================
# Database (Postgres) — the NestJS API reads DATABASE_URL.
# On Railway, ${{...}} are template references resolved automatically; for local
# dev, set DATABASE_URL to the compose value above (or your own Postgres).
# ============================================================
DATABASE_URL="postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}"
DATABASE_PUBLIC_URL="postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_TCP_PROXY_DOMAIN}}:${{RAILWAY_TCP_PROXY_PORT}}/${{PGDATABASE}}"

PGHOST="${{RAILWAY_PRIVATE_DOMAIN}}"
PGPORT="5432"
PGUSER="${{POSTGRES_USER}}"
PGPASSWORD="${{POSTGRES_PASSWORD}}"
PGDATABASE="${{POSTGRES_DB}}"
PGDATA="/var/lib/postgresql/data/pgdata"
POSTGRES_DB="inspect"
POSTGRES_USER="inspect"
POSTGRES_PASSWORD="CHANGE_ME"      # set in your .env / Railway secret manager — never commit a real value
SSL_CERT_DAYS="820"

# ============================================================
# Redis — the NestJS API reads REDIS_URL (required to boot; the cache module throws if unset).
# ============================================================
REDIS_URL="redis://${{REDISUSER}}:${{REDIS_PASSWORD}}@${{REDISHOST}}:${{REDISPORT}}"
REDIS_PUBLIC_URL="redis://default:${{REDIS_PASSWORD}}@${{RAILWAY_TCP_PROXY_DOMAIN}}:${{RAILWAY_TCP_PROXY_PORT}}"
REDIS_PASSWORD="CHANGE_ME"         # set in your .env / Railway secret manager — never commit a real value

# ============================================================
# NextAuth (web console). NEXTAUTH_URL must match the web port (3001 in local dev).
# Generate AUTH_SECRET: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
# ============================================================
NEXTAUTH_URL="http://localhost:3001"
AUTH_SECRET="CHANGE_ME"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ============================================================
# Web console -> API. Base URL the Next.js console calls server-side (falls back to
# design demo data when unreachable). NextAuth signs in via this API's POST /auth/login.
# ============================================================
INSPECT_API_URL="http://localhost:3000"
# API_PORT=3000
# WEB_PORT=3001

# ============================================================
# API auth — JWT issued by the NestJS API (the API is the RBAC authority).
# Generate each: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
# ============================================================
JWT_ACCESS_SECRET="CHANGE_ME"
JWT_REFRESH_SECRET="CHANGE_ME"
JWT_ACCESS_TTL_SECONDS="900"
JWT_REFRESH_TTL_SECONDS="2592000"

# ============================================================
# Object storage (S3-compatible) — presigned photo + reference-image uploads (spec §13).
# Local dev: point at MinIO; access key/secret = MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
# (docker-compose.dev.yml creates the bucket and sets MINIO_API_CORS_ALLOW_ORIGIN).
#
# DEPLOYED SETUPS (INS-060) — the BROWSER uploads directly to S3_ENDPOINT, so:
#   1. S3_ENDPOINT must be BROWSER-REACHABLE and https:// (an internal hostname or a
#      plain http:// endpoint fails as mixed content / "Failed to fetch", never as an
#      HTTP status the console can report).
#   2. The BUCKET must allow CORS from the console origin — the API's own
#      ALLOWED_ORIGINS list is irrelevant to that hop. Minimum policy:
#        AllowedOrigins: <WEB_BASE_URL>   AllowedMethods: PUT, GET
#        AllowedHeaders: Content-Type, x-amz-*   ExposeHeaders: ETag
#   3. Objects must NOT be anonymously readable — the console serves them through
#      short-lived presigned GETs (PRESIGN_EXPIRES_SECONDS).
#   4. Managed endpoints answer 403 for ANY bucket name, so a wrong S3_BUCKET does
#      NOT surface as a 404 probe failure — it surfaces as a failing presigned PUT.
# REQUIRE_STORAGE=1 turns the integration suite's storage self-skip into a hard
# failure (CI sets it) so a storage regression can't silently drop coverage.
# ============================================================
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="inspect-photos"
S3_ACCESS_KEY_ID="CHANGE_ME"
S3_SECRET_ACCESS_KEY="CHANGE_ME"
S3_FORCE_PATH_STYLE="true"
MINIO_ROOT_USER="inspect"
MINIO_ROOT_PASSWORD="CHANGE_ME"

# ============================================================
# Email delivery (INS-004) — invitation + buyer-guest magic-link emails.
# SMTP_URL empty/unset = dev/json transport (each message is logged in full,
# not delivered). Real value MUST use smtp:// or smtps://, e.g.:
#   smtp://USER:PASSWORD@smtp.example.com:587
# (a malformed value degrades to dev/json mode with an error log — no email!)
# WEB_BASE_URL is the console base URL used to build /invite and /portal links.
# ============================================================
SMTP_URL=""
MAIL_FROM="Inspect <no-reply@inspect.local>"
WEB_BASE_URL="http://localhost:3001"

# ============================================================
# Tunables (INS-053) — all optional; the defaults shown here apply when unset.
# ALLOWED_ORIGINS: comma-separated CORS allowlist (falls back to WEB_BASE_URL;
# leave both unset ONLY in local dev — the API logs a warning and stays open).
# ============================================================
ALLOWED_ORIGINS=""
CACHE_TTL_MS="604800000"
CACHE_LRU_SIZE="5000"
INVITE_TTL_DAYS="14"
GUEST_TTL_DAYS="30"
PRESIGN_EXPIRES_SECONDS="900"

# ============================================================
# Rate limiting (INS-047) — applied PER-ROUTE to the PUBLIC endpoints only
# (login, refresh, invitation accept + lookup, guest report reads). Authenticated
# routes are already gated by JwtAuthGuard + RolesGuard and stay un-throttled.
# The defaults below are deliberately loose enough that the DB-backed integration
# suite cannot trip them. PRODUCTION SHOULD TIGHTEN: RATE_LIMIT_AUTH_LIMIT=10.
# RATE_LIMIT_TRUSTED_PROXIES = how many reverse proxies sit in front of the API;
# the client IP is taken that many entries from the RIGHT of X-Forwarded-For, so a
# client cannot forge a fresh bucket by prepending its own header. 0 = direct.
# ============================================================
RATE_LIMIT_DISABLED=""
RATE_LIMIT_AUTH_LIMIT="30"
RATE_LIMIT_AUTH_TTL_MS="60000"
RATE_LIMIT_INVITE_LIMIT="30"
RATE_LIMIT_INVITE_TTL_MS="60000"
RATE_LIMIT_GUEST_LIMIT="120"
RATE_LIMIT_GUEST_TTL_MS="60000"
RATE_LIMIT_TRUSTED_PROXIES="0"

# ============================================================
# Report signing (Ed25519, spec §9). Generate a PKCS8 PEM keypair and paste the
# PRIVATE key here (double-quoted; dotenv preserves the multiline value):
#   node -e "console.log(require('crypto').generateKeyPairSync('ed25519',{privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}}).privateKey.trim())"
# Keep the real key OUT of source control.
# ============================================================
REPORT_SIGNING_PRIVATE_KEY_PEM=""

# ============================================================
# First-Platform-Admin bootstrap (optional). When BOTH email + password are set,
# `prisma db seed` upserts an ACTIVE PLATFORM_ADMIN (orgId=null) — the only way to
# create the first admin (org/user creation is admin-gated). Idempotent; leave
# unset in prod once a real admin exists.
# ============================================================
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="Platform Admin"
