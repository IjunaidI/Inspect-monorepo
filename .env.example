# ============================================================
# Database (Railway / Postgres)
# Backend (NestJS + Prisma) reads DATABASE_URL.
#
# Note: ${{...}} entries are Railway template references and resolve
# automatically on Railway. For local dev, replace each with the
# actual value (use DATABASE_PUBLIC_URL / REDIS_PUBLIC_URL from your
# Railway "Networking → Public Network" panel).
# ============================================================
DATABASE_URL="postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}"
DATABASE_PUBLIC_URL="postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_TCP_PROXY_DOMAIN}}:${{RAILWAY_TCP_PROXY_PORT}}/${{PGDATABASE}}"

# Underlying Postgres credentials (Railway template variables)
PGHOST="${{RAILWAY_PRIVATE_DOMAIN}}"
PGPORT="5432"
PGUSER="${{POSTGRES_USER}}"
PGPASSWORD="${{POSTGRES_PASSWORD}}"
PGDATABASE="${{POSTGRES_DB}}"
PGDATA="/var/lib/postgresql/data/pgdata"
POSTGRES_DB="railway"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="gIqPIoiylMEwQQsmyggyfmQSHmLcifya"
SSL_CERT_DAYS="820"

# ============================================================
# Redis
# Backend reads REDIS_URL.
# ============================================================
REDIS_URL="redis://${{REDISUSER}}:${{REDIS_PASSWORD}}@${{REDISHOST}}:${{REDISPORT}}"
REDIS_PUBLIC_URL="redis://default:${{REDIS_PASSWORD}}@${{RAILWAY_TCP_PROXY_DOMAIN}}:${{RAILWAY_TCP_PROXY_PORT}}"
REDIS_PASSWORD="uuDWRzMqjIaFXKrEkKASWXBmZndtWVcq"

# ============================================================
# NextAuth (frontend)
# NEXTAUTH_URL must match the web port (default 3001 in local dev).
# Generate AUTH_SECRET: https://generate-secret.vercel.app/32
# GitHub OAuth credentials: https://github.com/settings/developers
# ============================================================
NEXTAUTH_URL="http://localhost:3001"
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ============================================================
# Misc / port overrides
# ============================================================
NODE_ENV="development"
# API_PORT=3000
# WEB_PORT=3001

# ============================================================
# Inspect MVP additions
# ============================================================
# Local-dev alternative to Railway: `docker compose -f docker-compose.dev.yml up -d`
# then use these instead of the Railway URLs above:
#   DATABASE_URL="postgresql://inspect:inspect@localhost:5432/inspect?schema=public"
#   REDIS_URL="redis://localhost:6379"

# --- API auth (JWT issued by the NestJS API; the API is the RBAC authority) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS="900"
JWT_REFRESH_TTL_SECONDS="2592000"

# --- Object storage (S3 / MinIO) — presigned photo uploads (spec §13) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="inspect-photos"
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE="true"
MINIO_ROOT_USER="inspect"
MINIO_ROOT_PASSWORD=

# --- Report signing (Ed25519, spec §9). Keep the real key out of source control. ---
REPORT_SIGNING_PRIVATE_KEY_PEM=
