# ============================================================
# Database (Railway / Postgres)
# Backend  (NestJS + TypeORM)        reads DATABASE_URL.
# Frontend (Next.js + Drizzle/Neon)  reads POSTGRES_URL.
# For local dev pointing at the same DB, set both to the same value.
# ============================================================
DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_PUBLIC_URL=postgresql://user:pass@public-host:port/dbname
POSTGRES_URL=postgresql://user:pass@host:5432/dbname

# Underlying credentials (Railway template variables)
PGHOST=host
PGPORT=5432
PGUSER=postgres
PGPASSWORD=changeme
PGDATABASE=railway
PGDATA=/var/lib/postgresql/data/pgdata
POSTGRES_DB=railway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
SSL_CERT_DAYS=820

# ============================================================
# Redis
# Backend reads REDIS_URL.
# ============================================================
REDIS_URL=redis://default:password@host:6379
REDIS_PUBLIC_URL=redis://default:password@public-host:port
REDIS_PASSWORD=changeme
REDISHOST=host
REDISPORT=6379
REDISUSER=default

# ============================================================
# NextAuth (frontend)
# NEXTAUTH_URL must match the web port (default 3001).
# ============================================================
NEXTAUTH_URL=http://localhost:3001
AUTH_SECRET=                                  # 32+ char random — https://generate-secret.vercel.app/32
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ============================================================
# Misc / port overrides
# ============================================================
NODE_ENV=development
# API_PORT=3000
# WEB_PORT=3001
