// ============================================================
// Inspect — Production Prisma Schema (MVP v1.0)
// Stack: NestJS (apps/api) · Next.js (apps/web) · PostgreSQL · Prisma
// ------------------------------------------------------------
// Derived from:
//   docs/done/specs/2026-06-06-inspect-mvp-requirements-design.md  (requirements)
//   docs/reference/inspect-schema.md                               (design + rationale)
//
// Conventions (see design doc §A):
//   • Multi-tenant isolation: every tenant-scoped row carries orgId (incl. the
//     queryable children: InspectionLoop, Photo, DefectInstance, AqlResult).
//     Pure leaf detail rows reached only via an already-scoped parent
//     (measurements, preset children, report delivery/access, junctions) omit it.
//   • Platform Admin = User with role=PLATFORM_ADMIN and orgId=null — the only
//     cross-tenant principal. There is no separate SuperAdmin table.
//   • Immutability via snapshots: anything feeding a signed report is frozen as
//     resolved JSON, not a live FK (loopPresetSnapshot, aqlPlan, computedSampling,
//     brandingSnapshot). Originating FKs are kept only for lineage.
//   • Deletion policy: Restrict on every reference to immutable/historical data;
//     SetNull on optional actor refs (deleting a user never erases history);
//     Cascade only for transient/draft children. Organizations are archived
//     (status), never hard-deleted — enforced by Restrict on all org-scoped FKs
//     except transient Invitations.
//   • No Postgres composite types — embedded blocks (tamperProof, gps, exif,
//     branding, AQL plan/sampling) are Json columns.
//   • ISO 2859-1 Table I (code letters) & Table II-A (Ac/Re) live as code/seed
//     lookup data, NOT as DB tables (spec §8). The global defect library (spec §7)
//     is seeded into DefectCatalog with orgId=null.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum OrgType {
  INSPECTION_COMPANY
  MANUFACTURER
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// Fixed, additive role hierarchy (spec §4). PLATFORM_ADMIN is cross-tenant.
enum UserRole {
  INSPECTOR
  QA_MANAGER
  ORG_OWNER
  PLATFORM_ADMIN
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

/// MVP is pre-shipment only (spec §6, §14#6). Extensible later.
enum InspectionType {
  PRE_SHIPMENT
}

/// Inspection lifecycle (spec §5).
enum InspectionStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REPORT_ISSUED
  REJECTED
  HOLD
}

/// ISO 2859-1 general / special inspection levels. MVP default = II.
enum AqlLevel {
  I
  II
  III
  S1
  S2
  S3
  S4
}

/// Defect severity drives the AQL class a defect counts against (spec §7, §8).
enum DefectSeverity {
  CRITICAL
  MAJOR
  MINOR
}

enum DefectScope {
  GLOBAL
  ORG
}

/// Per-class AQL outcome and the system's overall recommendation (spec §8).
enum AqlClassOutcome {
  PASS
  FAIL
}

/// QA Manager's binding decision (spec §8).
enum QaDecision {
  PASS
  FAIL
  HOLD
}

/// Photo provenance — drives the verified/unverified badge (spec §9).
enum PhotoSource {
  MOBILE_VERIFIED
  MANUAL_UPLOAD
}

enum ReportStatus {
  GENERATED
  DELIVERED
}

enum DeliveryChannel {
  EMAIL
  PORTAL
}

enum ReportAccessAction {
  VIEW
  DOWNLOAD
}

enum AuditActorType {
  USER
  PLATFORM_ADMIN
  COMPANY_GUEST
  SYSTEM
}

/// INS-055: company OWNERSHIP, orthogonal to trade role. Trade role lives on the
/// PurchaseOrder / Inspection / Report edge, never on the Company row.
enum CompanyKind {
  INTERNAL
  THIRD_PARTY
}

enum BillableEventKind {
  INSPECTION
  RE_INSPECTION
}

// ─────────────────────────────────────────────
// TENANCY & IDENTITY
// ─────────────────────────────────────────────

/// A paying customer workspace — fully isolated. An Org is either an inspection
/// company or a manufacturer (spec §2, §3). Root of tenant isolation.
/// NOTE: name uniqueness is case-insensitive + trimmed and enforced by a raw
/// UNIQUE INDEX on lower(btrim(name)) in the migration, because Prisma's DSL
/// cannot express a functional index. @@unique([name]) would let "polo" and
/// "Polo " both through.
model Organization {
  id        String    @id @default(cuid())
  name      String
  type      OrgType
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users           User[]
  invitations     Invitation[]
  buyers          Buyer[]
  buyerGuests     BuyerGuest[]
  suppliers       Supplier[]
  companies       Company[]
  companyGuests   CompanyGuest[]
  products        Product[]
  purchaseOrders  PurchaseOrder[]
  loopPresets     LoopPreset[]
  defectCatalog   DefectCatalog[]
  inspections     Inspection[]
  inspectionItems InspectionLoopItem[]
  photos          Photo[]
  defectInstances DefectInstance[]
  aqlResults      AqlResult[]
  reports         Report[]
  billableEvents  BillableEvent[]
  auditLogs       AuditLog[]

  @@map("organizations")
}

/// Platform identity. role=PLATFORM_ADMIN + orgId=null is the cross-tenant admin.
model User {
  id           String     @id @default(cuid())
  orgId        String? // null = Platform Admin (cross-tenant)
  email        String     @unique
  passwordHash String?
  name         String
  avatarUrl    String?
  role         UserRole
  status       UserStatus @default(INVITED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Restrict)

  invitationsSent     Invitation[] @relation("InvitationInvitedBy")
  loopPresetsCreated  LoopPreset[] @relation("LoopPresetCreatedBy")
  inspectionsCreated  Inspection[] @relation("InspectionCreatedBy")
  inspectionsAssigned Inspection[] @relation("InspectionAssignedInspector")
  photosUploaded      Photo[]      @relation("PhotoUploader")
  aqlDecisions        AqlResult[]  @relation("AqlDecidedBy")
  auditLogs           AuditLog[]   @relation("AuditActorUser")

  @@index([orgId])
  @@index([orgId, role])
  @@map("users")
}

/// Pending invite before account activation. Invite-only onboarding (spec §3).
model Invitation {
  id          String    @id @default(cuid())
  orgId       String
  email       String
  role        UserRole
  token       String    @unique @default(cuid())
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String?
  createdAt   DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([token])
  @@map("invitations")
}

// ─────────────────────────────────────────────
// COUNTERPARTIES  (Buyer · BuyerGuest · Supplier · Product · PurchaseOrder)
// ─────────────────────────────────────────────

/// The party a report is for. Branding here drives per-buyer report styling
/// (spec §5). Managed by QA Manager and above.
model Buyer {
  id                  String    @id @default(cuid())
  orgId               String
  name                String
  logoUrl             String?
  primaryColor        String?
  branding            Json?
  defaultLoopPresetId String?
  createdByUserId     String?
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization      Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  defaultLoopPreset LoopPreset?  @relation("BuyerDefaultPreset", fields: [defaultLoopPresetId], references: [id], onDelete: SetNull)

  guests         BuyerGuest[]
  purchaseOrders PurchaseOrder[]
  inspections    Inspection[]
  reports        Report[]

  /// INS-010: composite parent key so org-scoped children (BuyerGuest) can carry a
  /// tenant-aligned FK the DATABASE checks, not just the app layer.
  @@unique([id, orgId])
  @@unique([orgId, name])
  @@index([orgId])
  @@map("buyers")
}

/// Read-only guest login scoped to ONE buyer's reports within ONE tenant
/// (spec §5). Magic-link auth (token + expiry). Never visible across tenants.
model BuyerGuest {
  id             String     @id @default(cuid())
  buyerId        String
  orgId          String
  email          String
  status         UserStatus @default(INVITED)
  token          String?    @unique
  tokenExpiresAt DateTime?
  lastAccessAt   DateTime?
  createdAt      DateTime   @default(now())

  // INS-010: tenant-aligned composite FK — a guest can only hang off a buyer in
  // its OWN org, enforced by the database rather than by caller discipline.
  buyer          Buyer          @relation(fields: [buyerId, orgId], references: [id, orgId], onDelete: Cascade)
  organization   Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  reportAccesses ReportAccess[]

  @@unique([buyerId, email])
  @@index([orgId])
  @@index([token])
  @@map("buyer_guests")
}

/// The production site being inspected (spec §5).
model Supplier {
  id              String    @id @default(cuid())
  orgId           String
  name            String
  address         String?
  gps             Json?
  createdByUserId String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]
  inspections    Inspection[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("suppliers")
}

// ─────────────────────────────────────────────
// COMPANY  (INS-055 — replaces Buyer + Supplier)
// ─────────────────────────────────────────────

/// A counterparty in one tenant (INS-055). Trade role (client / factory) is a
/// property of the PurchaseOrder / Inspection / Report EDGE, not of this row —
/// the same company may be the client on one PO and the factory on another.
/// `kind` is the orthogonal OWNERSHIP axis: our own facility vs an external
/// party. Deliberately NO `role` / `canBeClient` / `canBeFactory` (spec §0 P3):
/// flags would re-encode the split this model exists to remove.
model Company {
  id    String      @id @default(cuid())
  orgId String
  name  String
  kind  CompanyKind @default(THIRD_PARTY)

  // Client-role identity (ex-Buyer). `logoUrl` is a DURABLE object key or a
  // legacy absolute URL, never a presigned URL — it freezes verbatim into
  // Report.brandingSnapshot at generate time and is never read live by a report.
  logoUrl             String?
  primaryColor        String?
  branding            Json?
  defaultLoopPresetId String?

  // Factory-role identity (ex-Supplier).
  address String?
  gps     Json?

  createdByUserId String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization      Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  defaultLoopPreset LoopPreset?  @relation("CompanyDefaultPreset", fields: [defaultLoopPresetId], references: [id], onDelete: SetNull)

  guests        CompanyGuest[]
  poAsClient    PurchaseOrder[] @relation("PurchaseOrderClient")
  poAsFactory   PurchaseOrder[] @relation("PurchaseOrderFactory")
  inspAsClient  Inspection[]    @relation("InspectionClient")
  inspAsFactory Inspection[]    @relation("InspectionFactory")
  reports       Report[]        @relation("ReportClient")

  /// INS-010: composite parent key so org-scoped children (CompanyGuest) can
  /// carry a tenant-aligned FK the DATABASE checks, not just the app layer.
  @@unique([id, orgId])
  /// NOT @@unique([orgId, name]) — the business key is a PARTIAL, case- and
  /// whitespace-insensitive unique index over ACTIVE rows only (spec §6.6 / P5),
  /// which Prisma's DSL cannot express. It is added by hand in the
  /// 20260827000000_drop_buyer_supplier migration.
  @@index([orgId])
  @@index([orgId, name])
  @@map("companies")
}

/// Read-only guest login scoped to ONE company's CLIENT-role reports within ONE
/// tenant (spec §4). Magic-link auth (token + expiry). Never visible across
/// tenants, and never attached to a company in its factory role (spec §0 P7 —
/// there is no factory-side portal).
model CompanyGuest {
  id             String     @id @default(cuid())
  companyId      String
  orgId          String
  email          String
  status         UserStatus @default(INVITED)
  token          String?    @unique
  tokenExpiresAt DateTime?
  lastAccessAt   DateTime?
  createdAt      DateTime   @default(now())

  // INS-010: tenant-aligned composite FK — a guest can only hang off a company
  // in its OWN org, enforced by the database rather than by caller discipline.
  company        Company        @relation(fields: [companyId, orgId], references: [id, orgId], onDelete: Cascade)
  organization   Organization   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  reportAccesses ReportAccess[]

  @@unique([companyId, email])
  @@index([orgId])
  @@index([token])
  @@map("company_guests")
}

model Product {
  id              String    @id @default(cuid())
  orgId           String
  styleNumber     String
  description     String?
  createdByUserId String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]
  inspections    Inspection[]

  @@unique([orgId, styleNumber])
  @@index([orgId])
  @@map("products")
}

/// Links a buyer and a supplier for a product (spec §5).
model PurchaseOrder {
  id       String @id @default(cuid())
  orgId    String
  poNumber String

  // INS-055: LEGACY, dropped in 20260827000000_drop_buyer_supplier. Relaxed to
  // nullable so the write path can stop setting them one consumer at a time.
  buyerId    String?
  supplierId String?

  // INS-055: the two-party trade edge. Both required in practice (tightened to
  // NOT NULL by the drop migration); a PO with one party is not a PO.
  clientCompanyId  String?
  factoryCompanyId String?

  productId       String
  totalQuantity   Int?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  buyer          Buyer?       @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  supplier       Supplier?    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  clientCompany  Company?     @relation("PurchaseOrderClient", fields: [clientCompanyId], references: [id], onDelete: Restrict)
  factoryCompany Company?     @relation("PurchaseOrderFactory", fields: [factoryCompanyId], references: [id], onDelete: Restrict)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  inspections    Inspection[]

  @@unique([orgId, poNumber])
  @@index([orgId])
  @@index([buyerId])
  @@index([supplierId])
  @@index([clientCompanyId])
  @@index([factoryCompanyId])
  @@index([productId])
  @@map("purchase_orders")
}

// ─────────────────────────────────────────────
// LOOP PRESETS  (spec §6)
// ─────────────────────────────────────────────

/// Reusable, ordered sequence of zone steps. Versioned; can be a buyer default.
model LoopPreset {
  id              String    @id @default(cuid())
  orgId           String
  name            String
  version         Int       @default(1)
  description     String?
  aqlLevel        AqlLevel?
  isArchived      Boolean   @default(false)
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization        Organization             @relation(fields: [orgId], references: [id], onDelete: Restrict)
  createdBy           User?                    @relation("LoopPresetCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items               PresetLoopItem[]
  measurementFields   PresetMeasurementField[]
  allowedDefects      PresetAllowedDefect[]
  inspections         Inspection[]
  defaultForBuyers    Buyer[]                  @relation("BuyerDefaultPreset")
  defaultForCompanies Company[]                @relation("CompanyDefaultPreset")

  @@unique([orgId, name, version])
  @@index([orgId])
  @@index([orgId, isArchived])
  @@map("loop_presets")
}

/// One ordered capture point in a loop (INS-081). Takes exactly ONE image —
/// there is no shot count, because an item IS a shot.
model PresetLoopItem {
  id                String   @id @default(cuid())
  loopPresetId      String
  position          Int
  itemName          String
  description       String?
  referenceImageUrl String?
  createdAt         DateTime @default(now())

  loopPreset LoopPreset @relation(fields: [loopPresetId], references: [id], onDelete: Cascade)

  @@unique([loopPresetId, position])
  @@index([loopPresetId])
  @@map("preset_loop_items")
}

/// Measurement sheet defined ONCE per loop (INS-081) and filled once per cycle.
/// Free-form (spec §9, §14#9: no target/tolerance/grading); `unit` is optional
/// free text (e.g. "cm", "GSM").
model PresetMeasurementField {
  id           String  @id @default(cuid())
  loopPresetId String
  position     Int
  label        String
  unit         String?

  loopPreset LoopPreset @relation(fields: [loopPresetId], references: [id], onDelete: Cascade)

  @@unique([loopPresetId, position])
  @@index([loopPresetId])
  @@map("preset_measurement_fields")
}

/// Junction: which catalog defects are taggable anywhere in this loop (INS-081 —
/// loop-global, no longer per item).
model PresetAllowedDefect {
  loopPresetId    String
  defectCatalogId String

  loopPreset    LoopPreset    @relation(fields: [loopPresetId], references: [id], onDelete: Cascade)
  defectCatalog DefectCatalog @relation(fields: [defectCatalogId], references: [id], onDelete: Restrict)

  @@id([loopPresetId, defectCatalogId])
  @@index([defectCatalogId])
  @@map("preset_allowed_defects")
}

// ─────────────────────────────────────────────
// DEFECT CATALOG  (spec §7)
// ─────────────────────────────────────────────

/// Hybrid defect library: GLOBAL seeded rows (orgId=null) + per-org custom rows.
/// defaultSeverity pre-classifies a defect so counts feed AQL directly.
/// NOTE: global-name uniqueness (orgId IS NULL) is enforced by a PARTIAL UNIQUE
/// INDEX added in the migration, because Postgres treats NULLs as distinct so
/// @@unique([orgId, name]) alone cannot dedupe global rows.
model DefectCatalog {
  id              String         @id @default(cuid())
  scope           DefectScope
  orgId           String? // null = GLOBAL seeded library
  name            String
  defaultSeverity DefectSeverity
  isArchived      Boolean        @default(false)
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization?         @relation(fields: [orgId], references: [id], onDelete: Restrict)
  presetUsages    PresetAllowedDefect[]
  defectInstances DefectInstance[]

  @@unique([orgId, name])
  @@index([scope])
  @@index([orgId])
  @@map("defect_catalog")
}

// ─────────────────────────────────────────────
// INSPECTIONS  (spec §5, §8)
// ─────────────────────────────────────────────

/// The core aggregate: one pre-shipment inspection of a lot.
model Inspection {
  id    String @id @default(cuid())
  orgId String

  // INS-055: LEGACY, dropped in 20260827000000_drop_buyer_supplier.
  buyerId    String?
  supplierId String?

  // INS-055: denormalized from the PO at create time, mirroring buyerId /
  // supplierId. The factory edge stays OPTIONAL with SetNull, exactly as
  // supplierId is today.
  clientCompanyId  String?
  factoryCompanyId String?

  poId           String
  productId      String
  lotSize        Int?
  inspectionType InspectionType   @default(PRE_SHIPMENT)
  status         InspectionStatus @default(DRAFT)

  // Preset lineage (FK) + immutable resolved snapshot (rendered for the report).
  loopPresetId       String?
  loopPresetSnapshot Json?

  // AQL plan (QA input) + computed sampling (algorithm output). Both snapshotted.
  aqlLevel         AqlLevel @default(II)
  aqlPlan          Json? // { critical:{aql}, major:{aql}, minor:{aql} }
  computedSampling Json? // { sampleSizeCodeLetter, sampleSize, perClass:{class:{ac,re}} }

  // Quantity / carton verification (report §3).
  cartonsTotal      Int?
  cartonsInspected  Int?
  quantityPresented Int?
  quantityShortfall Int?

  // Inspection-level notes (report §7).
  workmanshipNotes String?
  packagingNotes   String?

  // Assigned inspector (future mobile) vs the ACTUAL submitter recorded in the
  // locked tamper-proof block (Platform Admin in MVP). Kept distinct on purpose.
  assignedInspectorId String?
  tamperProof         Json? // locked on submit: { inspectorId, deviceId, submittedAt, gps }
  submittedAt         DateTime?

  // Re-inspection chain — a new billable inspection superseding a failed one.
  supersedesInspectionId String?

  // Client-supplied idempotency token (offline-sync readiness, spec §13).
  // Unique per org WHEN provided (see @@unique below); tokenless rows are allowed
  // (Postgres treats NULLs as distinct), so server-created rows need not carry one.
  clientRequestId String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization      Organization  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  buyer             Buyer?        @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  supplier          Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  clientCompany     Company?      @relation("InspectionClient", fields: [clientCompanyId], references: [id], onDelete: Restrict)
  factoryCompany    Company?      @relation("InspectionFactory", fields: [factoryCompanyId], references: [id], onDelete: SetNull)
  purchaseOrder     PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Restrict)
  product           Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  loopPreset        LoopPreset?   @relation(fields: [loopPresetId], references: [id], onDelete: SetNull)
  createdBy         User?         @relation("InspectionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignedInspector User?         @relation("InspectionAssignedInspector", fields: [assignedInspectorId], references: [id], onDelete: SetNull)
  supersedes        Inspection?   @relation("ReInspection", fields: [supersedesInspectionId], references: [id], onDelete: Restrict)
  supersededBy      Inspection[]  @relation("ReInspection")

  items         InspectionLoopItem[]
  measurements  InspectionMeasurement[]
  photos        Photo[]
  defects       DefectInstance[]
  aqlResult     AqlResult?
  report        Report?
  billableEvent BillableEvent?

  /// INS-010: composite parent key. Every org-scoped child of an inspection
  /// (loops, photos, defects, AQL result) references [id, orgId] so a child can
  /// never be attached to a row from another tenant — previously the denormalized
  /// child orgId was checked only in application code.
  @@unique([id, orgId])
  @@unique([orgId, clientRequestId])
  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, createdAt(sort: Desc)])
  @@index([poId])
  @@index([buyerId])
  @@index([clientCompanyId])
  @@index([supersedesInspectionId])
  @@map("inspections")
}

/// The inspection's frozen copy of one loop item (INS-081). No shot count and no
/// per-item defect snapshot: the allowed-defect list is loop-global and already
/// resolved inside Inspection.loopPresetSnapshot. Per-item status does not exist
/// (spec §8: pass/fail is whole-inspection).
model InspectionLoopItem {
  id                String   @id @default(cuid())
  inspectionId      String
  orgId             String
  position          Int
  itemName          String
  description       String?
  referenceImageUrl String?
  notes             String?
  createdAt         DateTime @default(now())

  // INS-010: tenant-aligned composite FK (see Inspection.@@unique([id, orgId])).
  inspection   Inspection       @relation(fields: [inspectionId, orgId], references: [id, orgId], onDelete: Cascade)
  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  photos       Photo[]
  defects      DefectInstance[]

  @@unique([inspectionId, position])
  @@index([inspectionId])
  @@index([orgId])
  @@map("inspection_loop_items")
}

/// Free-form measured value recorded once per CYCLE (INS-081) — the sheet is
/// loop-global, so a measurement belongs to a unit, not to an item
/// (spec §9, §14#9).
model InspectionMeasurement {
  id            String  @id @default(cuid())
  inspectionId  String
  orgId         String
  cycleIndex    Int
  label         String
  recordedValue String?
  unit          String?
  notes         String?

  // INS-010: tenant-aligned composite FK.
  inspection Inspection @relation(fields: [inspectionId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([inspectionId, cycleIndex, label])
  @@index([inspectionId])
  @@map("inspection_measurements")
}

// ─────────────────────────────────────────────
// PHOTOS & PROVENANCE  (spec §9)
// ─────────────────────────────────────────────

/// A captured/uploaded photo, addressed by its SLOT: (loop item, cycle). INS-081
/// removed the "floating photo" state — every upload targets a known slot, and
/// @@unique([inspectionLoopItemId, cycleIndex]) makes one-image-per-slot a
/// database guarantee rather than a UI convention. `source` drives the
/// verified/unverified badge; contentHash feeds the report signature.
model Photo {
  id                   String      @id @default(cuid())
  orgId                String
  inspectionId         String
  inspectionLoopItemId String
  /// 0-based; rendered 1-based ("Unit 7"). Gaps are legal — see cycle-state.ts.
  cycleIndex           Int
  storageKey           String
  thumbnailKey         String?
  source               PhotoSource
  uploaderUserId       String?
  capturedAt           DateTime?
  gps                  Json?
  deviceId             String?
  exif                 Json?
  contentHash          String
  annotations          Json?
  clientRequestId      String?
  createdAt            DateTime    @default(now())

  organization       Organization          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  // INS-010: tenant-aligned composite FK to the inspection aggregate.
  inspection         Inspection            @relation(fields: [inspectionId, orgId], references: [id, orgId], onDelete: Cascade)
  inspectionLoopItem InspectionLoopItem    @relation(fields: [inspectionLoopItemId], references: [id], onDelete: Cascade)
  uploader           User?                 @relation("PhotoUploader", fields: [uploaderUserId], references: [id], onDelete: SetNull)
  defects            DefectInstancePhoto[]

  @@unique([orgId, clientRequestId])
  @@unique([inspectionLoopItemId, cycleIndex])
  @@index([orgId])
  @@index([inspectionId])
  @@index([inspectionLoopItemId])
  @@index([contentHash])
  @@map("photos")
}

// ─────────────────────────────────────────────
// DEFECT INSTANCES  (spec §5, §7)
// ─────────────────────────────────────────────

/// A defect recorded on an inspection. Either references a DefectCatalog entry
/// OR carries free-text (one-off). Severity feeds AQL class counts.
/// INS-081: the taggable list is loop-global, but the recorded instance pins to
/// a SLOT — (inspectionLoopItemId, cycleIndex) — so the report can say
/// "Unit 7 · Right sleeve". Both are set together or both omitted.
model DefectInstance {
  id                   String         @id @default(cuid())
  orgId                String
  inspectionId         String
  inspectionLoopItemId String?
  cycleIndex           Int?
  defectCatalogId      String?
  customText           String?
  severity             DefectSeverity
  notes                String?
  createdByUserId      String?
  /// Idempotency token (INS-044): a retried add-defect must not duplicate the
  /// row — a phantom duplicate could flip the AQL verdict. Mirrors Inspection
  /// and Photo.
  clientRequestId      String?
  createdAt            DateTime       @default(now())

  organization       Organization          @relation(fields: [orgId], references: [id], onDelete: Restrict)
  // INS-010: tenant-aligned composite FK (item link stays single-column — SetNull).
  inspection         Inspection            @relation(fields: [inspectionId, orgId], references: [id, orgId], onDelete: Cascade)
  inspectionLoopItem InspectionLoopItem?   @relation(fields: [inspectionLoopItemId], references: [id], onDelete: SetNull)
  defectCatalog      DefectCatalog?        @relation(fields: [defectCatalogId], references: [id], onDelete: Restrict)
  photos             DefectInstancePhoto[]

  @@unique([orgId, clientRequestId])
  @@index([orgId])
  @@index([inspectionId])
  @@index([inspectionId, severity])
  @@index([inspectionId, cycleIndex])
  @@map("defect_instances")
}

/// Junction linking defect instances to their evidence photos (report §5).
model DefectInstancePhoto {
  defectInstanceId String
  photoId          String

  defectInstance DefectInstance @relation(fields: [defectInstanceId], references: [id], onDelete: Cascade)
  photo          Photo          @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([defectInstanceId, photoId])
  @@index([photoId])
  @@map("defect_instance_photos")
}

// ─────────────────────────────────────────────
// AQL RESULT  (spec §8)
// ─────────────────────────────────────────────

/// System recommendation + QA Manager's binding decision for an inspection.
/// Per-class detail (found/ac/re/outcome) is JSON; the queried decision fields
/// are columns so "pending QA review" = qaDecision IS NULL.
model AqlResult {
  id                   String          @id @default(cuid())
  inspectionId         String          @unique
  orgId                String
  perClass             Json // { critical:{found,ac,re,outcome}, major:{...}, minor:{...} }
  systemRecommendation AqlClassOutcome
  qaDecision           QaDecision?
  qaRemarks            String?
  decidedByUserId      String?
  decidedAt            DateTime?
  createdAt            DateTime        @default(now())

  // INS-010: tenant-aligned composite FK (see Inspection.@@unique([id, orgId])).
  inspection   Inspection   @relation(fields: [inspectionId, orgId], references: [id, orgId], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  decidedBy    User?        @relation("AqlDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  /// Required by Prisma so the composite tenant-aligned FK below still reads as
  /// 1:1 (inspectionId alone is already @unique, so this adds no new restriction).
  @@unique([inspectionId, orgId])
  @@index([orgId])
  @@index([orgId, qaDecision])
  @@map("aql_results")
}

// ─────────────────────────────────────────────
// REPORTS  (spec §10)
// ─────────────────────────────────────────────

/// The immutable, signed PDF artifact. brandingSnapshot freezes the buyer theme;
/// contentHash + signature are the Ed25519 tamper-proof seal; verificationToken
/// powers the public verification page (spec §9). No updatedAt — immutable.
model Report {
  id           String @id @default(cuid())
  inspectionId String @unique
  orgId        String

  // INS-055: LEGACY, dropped in 20260827000000_drop_buyer_supplier.
  buyerId String?

  /// INS-055: the client this signed artifact belongs to. This is the column the
  /// guest-visibility predicate keys on (with orgId) — see spec §4.2. There is
  /// deliberately NO factoryCompanyId: the factory identity that matters legally
  /// is already frozen inside the signed canonical snapshot, and a live FK for it
  /// would be a second, MUTABLE source of truth for a fact the signature covers.
  clientCompanyId String?

  pdfStorageKey     String?
  brandingSnapshot  Json
  // The exact canonicalized payload that was hashed + signed (inspection state +
  // ordered photo hashes + metadata). Frozen so the public verification page can
  // recompute contentHash and verify the Ed25519 signature without re-deriving it
  // and without trusting the portal (spec §9).
  // NOT NULL since INS-046: verifyByToken() recomputes the hash FROM this column,
  // so a signed report with a null snapshot would report valid:false forever — a
  // silently unverifiable artifact. The DB now refuses to store one.
  canonicalSnapshot Json
  contentHash       String
  signature         String
  /// INS-055 spec §5.3: an UNSIGNED mirror of the `canonicalVersion` marker that
  /// lives INSIDE canonicalSnapshot, for indexing and operational reporting only.
  /// NEVER the dispatch authority — canonicalVersionOf() reads the signed
  /// payload. If this column and the payload disagree, the payload wins and the
  /// row was edited. Default 1: every report signed before INS-055.
  canonicalVersion  Int          @default(1)
  verificationToken String       @unique @default(cuid())
  status            ReportStatus @default(GENERATED)
  deliveredAt       DateTime?
  generatedAt       DateTime     @default(now())

  inspection    Inspection       @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  organization  Organization     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  buyer         Buyer?           @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  clientCompany Company?         @relation("ReportClient", fields: [clientCompanyId], references: [id], onDelete: Restrict)
  deliveries    ReportDelivery[]
  accesses      ReportAccess[]

  @@index([orgId])
  @@index([buyerId])
  @@index([clientCompanyId])
  @@index([verificationToken])
  @@map("reports")
}

/// One delivery event of a report (spec §10: email + portal).
model ReportDelivery {
  id             String          @id @default(cuid())
  reportId       String
  channel        DeliveryChannel
  recipientEmail String?
  deliveredAt    DateTime        @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_deliveries")
}

/// One access (view/download) of a report — typically by a buyer guest. Gives
/// the access audit a concrete principal (spec §11 guest portal).
model ReportAccess {
  id             String             @id @default(cuid())
  reportId       String
  /// INS-055: LEGACY, dropped in 20260827000000_drop_buyer_supplier.
  buyerGuestId   String?
  companyGuestId String?
  action         ReportAccessAction
  ipAddress      String?
  userAgent      String?
  accessedAt     DateTime           @default(now())

  report       Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  buyerGuest   BuyerGuest?   @relation(fields: [buyerGuestId], references: [id], onDelete: SetNull)
  companyGuest CompanyGuest? @relation(fields: [companyGuestId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([buyerGuestId])
  @@index([companyGuestId])
  @@map("report_accesses")
}

// ─────────────────────────────────────────────
// BILLING  (spec §14#16: per inspection)
// ─────────────────────────────────────────────

/// One billable event per inspection (including each re-inspection in a chain).
/// No invoicing UI in MVP — this just records the billable fact.
model BillableEvent {
  id           String            @id @default(cuid())
  orgId        String
  inspectionId String            @unique
  kind         BillableEventKind
  occurredAt   DateTime          @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  inspection   Inspection   @relation(fields: [inspectionId], references: [id], onDelete: Restrict)

  @@index([orgId])
  @@map("billable_events")
}

// ─────────────────────────────────────────────
// AUDIT LOG  (spec §9: append-only, hash-chained)
// ─────────────────────────────────────────────

/// Append-only, hash-chained event trail. `sequence` is an APPLICATION-ASSIGNED
/// monotonic per-org counter giving the chain a deterministic total order (safer
/// than createdAt, which can collide). prevEntryHash links each entry to the
/// previous so retroactive edits break the chain. Append-only, monotonic-sequence
/// assignment, and the chain links are all enforced at the application layer.
model AuditLog {
  id            String         @id @default(cuid())
  orgId         String? // null = platform-level event
  actorUserId   String?
  actorType     AuditActorType
  action        String
  entityType    String?
  entityId      String?
  payloadHash   String
  prevEntryHash String?
  sequence      Int
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime       @default(now())

  organization Organization? @relation(fields: [orgId], references: [id], onDelete: Restrict)
  actorUser    User?         @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([orgId, sequence])
  @@index([orgId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}
